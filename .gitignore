# Root .gitignore for YAHAYASCHOOL

# OS Files
.DS_Store
Thumbs.db
*.pem

# Dependencies
node_modules/
*/node_modules/

# Environment files
.env
.env.*
!.env.example
frontend/.env*
frontend/.env.local
strapicms/.env*

# Next.js build
frontend/.next/
frontend/out/
frontend/build/

# Strapi build & SQLite database
strapicms/.tmp/
strapicms/.strapi/
strapicms/dist/
strapicms/build/
*.sqlite
*.sqlite3
*.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
