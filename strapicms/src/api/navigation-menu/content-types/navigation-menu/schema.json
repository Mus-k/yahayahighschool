{
  "kind": "collectionType",
  "collectionName": "navigation_menus",
  "info": {
    "singularName": "navigation-menu",
    "pluralName": "navigation-menus",
    "displayName": "[F] Navigation Menu",
    "description": "Dynamic website menus supporting nested children and multi-language links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "location": {
      "type": "enumeration",
      "enum": [
        "header",
        "footer",
        "topbar"
      ],
      "default": "header"
    },
    "ctaButtonTitle": {
      "type": "string"
    },
    "ctaButtonUrl": {
      "type": "string"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.menu-item"
    }
  }
}