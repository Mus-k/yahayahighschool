{
  "kind": "singleType",
  "collectionName": "login_pages",
  "info": {
    "singularName": "login-page",
    "pluralName": "login-pages",
    "displayName": "[F] Login Page",
    "description": "Portal login page branding, features, and form configuration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Portal Sign In - YAHAYASCOOL"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.meta"
    },
    "badgeLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "schoolName": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Yahaya International Islamic"
    },
    "schoolNameHighlight": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "and English High School"
    },
    "tagline": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "default": "Empowering minds through Islamic values and modern education."
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "login.feature-item"
    },
    "signInTitle": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Welcome Back"
    },
    "signInSubtitle": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Sign in to your YAHAYASCOOL account"
    },
    "identifierLabel": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Email Address"
    },
    "identifierPlaceholder": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "admin@yahayascool.edu.ng"
    },
    "passwordLabel": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Password"
    },
    "passwordPlaceholder": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "••••••••"
    },
    "rememberMeText": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Remember me"
    },
    "forgotPasswordText": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Forgot password?"
    },
    "loginButtonText": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Sign In"
    },
    "versionText": {
      "type": "string",
      "default": "YAHAYASCOOL v1.0"
    },
    "copyrightText": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "© 2026 Yahaya International Islamic and English High School. All rights reserved."
    },
    "backToHomeText": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "default": "Back to Website"
    }
  }
}
