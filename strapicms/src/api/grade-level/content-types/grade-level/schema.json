{
  "kind": "collectionType",
  "collectionName": "grade_levels",
  "info": {
    "singularName": "grade-level",
    "pluralName": "grade-levels",
    "displayName": "Grade Level",
    "description": "Independent Grade Level entity — shared globally across all Academic Sections"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "capacity": {
      "type": "integer",
      "default": 35
    },
    "ageRange": {
      "type": "string"
    },
    "promotionCriteria": {
      "type": "json"
    },
    "sections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::section.section",
      "mappedBy": "gradeLevels"
    },
    "curriculum": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curriculum.curriculum",
      "inversedBy": "gradeLevels"
    },
    "courseOfferings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-offering.course-offering",
      "mappedBy": "gradeLevel"
    },
    "homerooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::homeroom.homeroom",
      "mappedBy": "gradeLevel"
    }
  }
}