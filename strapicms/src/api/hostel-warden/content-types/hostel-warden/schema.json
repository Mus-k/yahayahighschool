{
  "kind": "collectionType",
  "collectionName": "hostel_wardens",
  "info": {
    "singularName": "hostel-warden",
    "pluralName": "hostel-wardens",
    "displayName": "Hostel Warden",
    "description": "Schema for Hostel Warden"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "employee": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive", "on_leave"],
      "default": "active"
    },
    "dutyShift": {
      "type": "enumeration",
      "enum": ["morning", "afternoon", "evening", "night", "full_day"],
      "default": "full_day"
    },
    "role": {
      "type": "enumeration",
      "enum": ["chief_warden", "warden", "assistant_warden", "resident_assistant"],
      "default": "warden"
    },
    "assignedBuilding": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hostel-building.hostel-building",
      "inversedBy": "wardens"
    },
    "assignedFloors": {
      "type": "json"
    },
    "emergencyContacts": {
      "type": "json"
    },
    "notes": {
      "type": "text"
    }
  }
}